<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>{{subject}}</title>
  </head>
  <body
    style='
      margin: 0;
      padding: 0;
      background-color: #f5f6fa;
      font-family: Arial, Helvetica, sans-serif;
      font-size: 16px;
    '
  >
    <table
      role='presentation'
      width='100%'
      cellspacing='0'
      cellpadding='0'
      style='background-color: #f5f6fa; padding: 40px 0'
    >
      <tr>
        <td align='center'>
          <table
            role='presentation'
            width='100%'
            cellspacing='0'
            cellpadding='0'
            style='
              max-width: 600px;
              background-color: #ffffff;
              border-radius: 10px;
              overflow: hidden;
              padding: 32px;
            '
          >
            <!-- Header -->
            {{> header }}

            <!-- Body --> 
            {{{body}}}

            <!-- Footer -->
            {{> footer }}
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>